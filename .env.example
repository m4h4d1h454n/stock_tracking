# Get this from @BotFather on Telegram after creating your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your personal Telegram chat id, so the bot can push you price alerts.
# Easiest way to find it: message @userinfobot on Telegram, it replies
# with your numeric chat id.
CHAT_ID=your_chat_id_here

# How often (seconds) to re-check price alerts against the live market
ALERT_CHECK_INTERVAL_SECONDS=300
