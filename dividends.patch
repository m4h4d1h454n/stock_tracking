+
+
+async def cb_div_kind(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    query = update.callback_query
+    _, kind, code = query.data.split(":", 2)
+    h = portfolio.get_holdings().get(code)
+    if not h:
+        await query.answer("You no longer hold this code.", show_alert=True)
