+async def cmd_dividend(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    """/dividend CODE cash AMOUNT|PCT% [QTY]   or   /dividend CODE stock PCT% [QTY]"""
+    clear_flow(context)
+    if not context.args:
+        await cmd_dividends(update, context)
+        return
+    try:
+        code, kind, raw = context.args[0], context.args[1].lower(), context.args[2]
+        qty = float(context.args[3]) if len(context.args) > 3 else None
+        if kind not in ("cash", "stock"):
+            raise ValueError
+    except (IndexError, ValueError):
+        await update.message.reply_text(
+            "Usage:\n"
+            "/dividend CODE cash AMOUNT|PCT% [QTY]\n"
+            "/dividend CODE stock PCT% [QTY]\n\n"
+            "e.g. /dividend BRACBANK cash 1.5  (৳1.5 per share)\n"
+            f"/dividend BRACBANK cash 15%  (15% of ৳{FACE_VALUE:g} face value)\n"
+            "/dividend BRACBANK stock 10%  (1 bonus share per 10 held)\n\n"
+            "QTY is optional — it defaults to the shares you hold now."
+        )
+        return
+    try:
+        text = apply_dividend(code, kind, raw, qty)
+    except ValueError as e:
+        await update.message.reply_text(f"⚠️ {e}")
+        return
+    await update.message.reply_text(text, reply_markup=MAIN_MENU_KEYBOARD)
+
+
+def dividend_pick_view() -> tuple[str, InlineKeyboardMarkup | None]:
+    holdings = portfolio.get_holdings()
+    if not holdings:
+        return (
+            "You don't hold any positions yet. For a stock you no longer hold, use "
+            "/dividend CODE cash AMOUNT QTY.",
+            None,
+        )
+    buttons = [
+        [InlineKeyboardButton(f"{code}  ({h.qty:g})", callback_data=f"div_pick:{code}")]
+        for code, h in sorted(holdings.items())
+    ]
+    return "💵 *Dividend — pick a code*\n\nChoose one of your holdings:", InlineKeyboardMarkup(buttons)
+
+
+async def cb_div_add(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    query = update.callback_query
