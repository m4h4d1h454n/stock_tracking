+    context.user_data["flow"] = "div_value"
+    context.user_data["flow_code"] = code
+    context.user_data["flow_kind"] = kind
+    await query.answer()
+    if kind == "cash":
+        prompt = (
+            f"Send the *cash dividend per share* in ৳ (e.g. `1.5`), or as a % of "
+            f"face value (e.g. `15%` = ৳{15 / 100 * FACE_VALUE:g} on a ৳{FACE_VALUE:g} share)."
+        )
+    else:
+        prompt = "Send the *stock dividend %* (e.g. `10%` = 1 bonus share per 10 held)."
+    await query.edit_message_text(
+        f"💵 *{kind.title()} dividend — {code}* (you hold {h.qty:g})",
+        parse_mode=ParseMode.MARKDOWN,
+    )
+    await context.bot.send_message(
+        chat_id=query.message.chat_id,
+        text=prompt,
+        parse_mode=ParseMode.MARKDOWN,
+        reply_markup=CANCEL_KEYBOARD,
+    )
+
+
+async def dividend_got_value(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    code = context.user_data.get("flow_code")
