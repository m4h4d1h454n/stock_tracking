+def apply_dividend(code: str, kind: str, raw: str, qty: float | None = None) -> str:
+    """
+    Record a dividend and return the confirmation text. Raises ValueError with
+    a user-readable message on bad input. Shared by /dividend and the guided flow.
+
+      cash : "1.5" = ৳1.5 per share, "15%" = 15% of face value (FACE_VALUE)
+      stock: "10" or "10%" = 10 bonus shares per 100 held (rounded down)
+    """
+    code = code.upper()
+    kind = kind.lower()
+    raw = raw.strip()
+    is_pct = raw.endswith("%")
+    try:
+        num = float(raw.rstrip("%").strip())
+    except ValueError:
+        raise ValueError("Send a number, e.g. 1.5 or 15%") from None
+    if num <= 0:
+        raise ValueError("The value must be positive.")
+
+    if kind == "cash":
+        per_share = num / 100 * FACE_VALUE if is_pct else num
+        d = portfolio.add_cash_dividend(code, per_share, qty)
+        return (
+            f"✅ Cash dividend: {d.code} — {d.qty:g} shares x {fmt_money(d.per_share)} "
+            f"= {fmt_money(d.total)}"
+        )
+    if kind == "stock":
+        tx = portfolio.add_stock_dividend(code, num, qty)
+        h = portfolio.get_holding(code)
+        return (
+            f"✅ Stock dividend: +{tx.qty:g} bonus {tx.code} shares ({num:g}%).\n"
+            f"You now hold {h.qty:g} @ avg {fmt_money(h.avg_cost)}"
+        )
+    raise ValueError("Type must be 'cash' or 'stock'.")
+
+
+def build_dividends_text(code: str | None = None) -> str:
+    divs = portfolio.get_dividends(code=code)
+    bonuses = [t for t in portfolio.get_transactions(code=code) if t.side == "bonus"]
+    if not divs and not bonuses:
+        return "No dividends recorded yet." + (f" ({code})" if code else "")
+
+    cash_by_code: dict[str, float] = {}
+    for d in divs:
+        cash_by_code[d.code] = cash_by_code.get(d.code, 0.0) + d.total
+    bonus_by_code: dict[str, float] = {}
+    for t in bonuses:
+        bonus_by_code[t.code] = bonus_by_code.get(t.code, 0.0) + t.qty
+
+    lines = ["*💵 Dividends*\n"]
+    for c in sorted(set(cash_by_code) | set(bonus_by_code)):
+        parts = []
+        if c in cash_by_code:
+            parts.append(f"{fmt_money(cash_by_code[c])} cash")
+        if c in bonus_by_code:
+            parts.append(f"+{bonus_by_code[c]:g} bonus shares")
+        lines.append(f"*{c}*: " + ", ".join(parts))
+    lines.append("")
+    lines.append(f"Total cash received: {fmt_money(sum(cash_by_code.values()))}")
+
+    recent = [(d.ts, _fmt_div_line(d)) for d in divs] + [(t.ts, _fmt_tx_line(t)) for t in bonuses]
+    recent.sort(key=lambda e: e[0], reverse=True)
+    lines.append("\n```\n" + "\n".join(line for _, line in recent[:10]) + "\n```")
+    return "\n".join(lines)
+
+
+def add_dividend_keyboard() -> InlineKeyboardMarkup:
